# CRENIX environment variables — TEMPLATE ONLY. Never commit real values.
# Copy to .env.local for development; set the same names in the hosting dashboard for production.
# Nothing in the app reads these yet (Steps 10–11 await owner approval).

# Public site URL (used for auth redirects, sitemap, canonical URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Step 10) ---
# Public by design: protected by Row Level Security, safe in the browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY — bypasses RLS. Never prefix with NEXT_PUBLIC_, never import in client components.
SUPABASE_SERVICE_ROLE_KEY=

# --- Payments (Step 11) — use TEST/SANDBOX keys until launch is approved ---
# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# or Opn Payments (Omise)
OPN_SECRET_KEY=
OPN_PUBLIC_KEY=

# --- AI providers (server only) ---
OPENAI_API_KEY=
# Optional: override the default text model (see src/server/ai/providers/openai.ts)
OPENAI_TEXT_MODEL=
# Must be "true" for AI generation to work in production (keep off until accounts + credits exist)
CRENIX_ENABLE_AI=
